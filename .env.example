# 우리 아이 미술관 — 컨테이너 설정(SD_04 10-5). 복사해서 쓴다: cp .env.example .env
# 비밀 값은 .env에만 둔다(git 제외). 문서·커밋·채팅에 적지 않는다. 만들기: openssl rand -hex 32

# 어느 묶음을 쓸지. 개발은 아래 그대로, 배포는 compose.yaml:compose.prod.yaml
COMPOSE_FILE=compose.yaml:compose.dev.yaml

# 입구(웹). 다른 PC에서 접속해 시험하려면 WEB_BIND=0.0.0.0
WEB_BIND=127.0.0.1
WEB_PORT=9501

# DB(컨테이너 db). 처음 띄울 때 이 값으로 DB와 사용자가 만들어진다
DB_HOST=db
DB_PORT=3306
DB_NAME=uam
DB_USER=uam
DB_PASSWORD=
MARIADB_ROOT_PASSWORD=

# 앱 API
APP_PORT=9521
SESSION_SECRET=
AUTH_HMAC_SECRET=
# 로컬 http에서는 false. https로 배포하면 true
SECURE_COOKIES=false
# 메일 링크의 기준 주소
APP_BASE_URL=http://localhost:9501
FILES_ACCEL=0

# 메일: 컨테이너 mailpit이 받는다(밖으로 보내지 않음). 받은 메일 화면은 http://localhost:8025
MAIL_ENABLED=true
MAIL_SMTP_URL=smtp://mailpit:1025
MAIL_FROM=no-reply@localhost

# 모델 서빙. 값의 근거는 SD_04 10-5·10-6
MODEL_API_INTERNAL_URL=http://model-api:9541
GPU_ENABLED=false
CAPTION_ENABLED=false
MODEL_CHECK_ENABLED=false

# 배포 묶음 전용: 엔진 이미지 이름(레지스트리 위치는 팀 결정), 메모리 한도
ENGINE_IMAGE=uri-gallery-engine:local
ENGINE_MEM_LIMIT=6g
WORKER_MEM_LIMIT=12g

# 쓰지 않음(이번 범위 밖). 비워 둔다
API_GUIDE_TEST_KEY=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

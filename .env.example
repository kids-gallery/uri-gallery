# 팀 DB — 값은 .env에만(문서·커밋에 적지 않음, research R-21)
DB_HOST=
DB_PORT=
DB_USER=
DB_NAME=ABC10pioneer1
DB_PASSWORD=
DB_SOCKET=                          # 로컬 시험용(선택)

# 앱 API (127.0.0.1). 컨테이너 배치 값은 SD_04 4-3
APP_PORT=9521
APP_HOST=127.0.0.1                  # compose는 0.0.0.0
TRUST_PROXY=loopback                # Express trust proxy. compose는 입구 nginx 망(예: uniquelocal)
# DB_PASSWORD_FILE·SESSION_SECRET_FILE·AUTH_HMAC_SECRET_FILE: 있으면 그 파일에서 읽는다(compose secrets)
SESSION_SECRET=                     # openssl rand -hex 32
AUTH_HMAC_SECRET=                   # 요청 한도용 이메일·IP 해시 키, openssl rand -hex 32
SECURE_COOKIES=true                 # 로컬 http 개발만 false
STORAGE_ROOT=/srv/uam/store         # 로컬 개발은 ./.data/store
APP_BASE_URL=http://127.0.0.1:9501  # 메일 링크 기준 주소
FILES_ACCEL=0                       # 운영(nginx X-Accel-Redirect)은 1

# 메일 (P0 Mailpit, U19)
MAIL_SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM=no-reply@localhost

# 서빙(A) — serving/common/config.py와 같은 이름
MODEL_API_INTERNAL_URL=http://127.0.0.1:9541
# MODEL_ROOT=                       # U14 닫음 — 비우면 <저장소>/models(코드 기본값). HF 캐시 models/hf/, M3 models/m3/
GPU_ENABLED=true                    # U2 P0 닫음 — Studio-B Apple GPU(MPS), M5를 GPU 워커로. GPU 없는 서버는 false(BR-SRV-02)
UAM_FAKE_MODELS=1                   # 1=전부 가짜, "M3,M7"=그 모델만 가짜. 운영(팀 서버)은 0
TORCHSERVE_URL=http://127.0.0.1:9561  # M3 TorchServe(R-03, ops/torchserve/config.properties)
M3_AD_PYTHON=                       # <저장소>/serving/.venv-m3/bin/python (R-03, M3 전용 conda 환경)
M3_AD_ROOT=                         # $MODEL_ROOT/m3/AnimatedDrawings (AD 커밋 b859684 고정)
M7_PYTHON=                          # (P1) <저장소>/serving/.venv-m7/bin/python — M7 TripoSR 전용 환경(research R-22, requirements-m7.lock). 비면 M7 적재 실패(model_not_ready)

# P0.5 설명
CAPTION_ENABLED=false
LLM_SERVER_URL=http://127.0.0.1:8200
OLLAMA_URL=http://127.0.0.1:11434   # localhost 금지(::1의 다른 인스턴스로 붙을 수 있음)
OLLAMA_CHAT_MODEL=qwen3:4b-instruct-2507-q4_K_M

# 모델 매니페스트(A 소유, G21 해시 대조) — serving/common/config.py와 같은 변수
MODEL_MANIFEST=../models/manifest.yaml

# API활용 시험 호출 키(ops:key issue --kind test 원문) — 커밋 금지
API_GUIDE_TEST_KEY=
MODEL_CHECK_ENABLED=false           # D20 모델 점검 — serving 점검 실행기(stage-job §13)와 runner 점유 조건 변경이 배포된 뒤 true
# 카카오 로그인(D36, research R-26) — 값은 서버 .env에만(권한 600). Redirect URI는 APP_BASE_URL + /v1/auth/kakao/callback
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 메일 발송(R-23 갱신 2): p1은 false(메일을 보내지 않는다). 비우면 켬(기존 이메일 흐름·E2E)
MAIL_ENABLED=

    "^\\s*<!--.*-->\\s*$"
  ],
  "issue_link": "(?i)\\b(close[sd]?|fix(e[sd])?|resolve[sd]?|refs?)\\s+#\\d+",
  "evidence_pattern": "`[^`]+`|\\d",
  "design_ref_pattern": "\\d",
  "design_none_pattern": "해당 없음",
  "branch_pattern": "^(feat|feature|fix|docs|refactor|test|chore)/\\d+-[a-z0-9][a-z0-9._-]*$",
  "commit_pattern": "^(feat|fix|docs|refactor|test|chore)(\\([^)]+\\))?: .+ \\(#\\d+\\)$",
  "commit_skip_pattern": "^(Merge |Revert \")",
  "secret_patterns": [
    "-----BEGIN [A-Z ]*PRIVATE KEY-----",
    "\\b(ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{30,}",
    "\\bgithub_pat_[A-Za-z0-9_]{30,}",
    "\\bAKIA[0-9A-Z]{16}\\b",
    "\\bsk-[A-Za-z0-9_-]{20,}",
    "\\bxox[abposr]-[A-Za-z0-9-]{10,}",
    "\\bAIza[0-9A-Za-z_-]{35}\\b",
    "^\\s*[A-Z0-9_]*(PASSWORD|SECRET|API_KEY|TOKEN|CLIENT_SECRET)[A-Z0-9_]*\\s*[:=]\\s*[^\\s$<{#\"']{8,}",
    "(?i)(password|passwd|secret)\\s*[:=]\\s*[\"'][^\"'$<{]{8,}[\"']"

{
  "name": "uam-web",
  "private": true,
  "version": "0.1.0",
  "description": "우리 아이 미술관 웹 (C) — Vue 3.5 + Vite 8 (D23). 보호자 /app · 운영 /ops",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:world": "node scripts/third-party-notices.mjs && vue-tsc --noEmit && vite build --mode world --outDir dist-world",
    "preview": "vite preview",
    "lint": "vue-tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "gen:api": "openapi-typescript ../contracts/openapi.yaml -o src/api/types.gen.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@types/three": "0.170.0",
    "fflate": "0.8.2",
    "pinia": "^3.0.4",
    "pretendard": "^1.3.9",
    "three": "0.170.0",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11"
  }
}

# .env.example — 키 이름만. 값은 적지 않는다. 이 파일은 올린다.
# 받는 사람이 복사해 .env 를 만든다:  cp .env.example .env
# 빈 값은 settings.py 의 기본값으로 대체된다(env_ignore_empty). 바꿀 것만 값을 적으면 된다.
# [주의] 값 뒤에 같은 줄로 주석(#)을 달지 않는다 — 주석이 값으로 읽힌다. 주석은 줄을 따로 쓴다.
MODEL_VERSION=
LOG_LEVEL=
MAX_BATCH_SIZE=
PORT=
# 판단보류 기준(기본 0.5). 평가 묶음 1차 측정(T137) 뒤 바꾼다
TAU=
# 이보다 짧은 변의 이미지는 422(기본 64)
MIN_SIDE_PX=
# 가중치 캐시 위치(기본 ../models/hf — 우리 서빙이 받아 둔 것)
HF_CACHE=
